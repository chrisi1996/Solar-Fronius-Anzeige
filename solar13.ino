// ---------------------------------------------------------------- Ablauf
void starteWlanAuswahl() {
  scanne();
  zeigeWlanListe();
  modus = M_WLAN_LISTE;
}

void nachWlanVerbunden() {
  configTzTime(ZEITZONE, "pool.ntp.org", "time.google.com");
  if (!inverterIp.length()) { eingabe = ""; zeigeIpEingabe(); modus = M_IP; }
  else {
    letzteAbfrage = millis();                       // erste Werte holen, bevor die Anzeige erscheint
    datenOk = frage();
    if (datenOk) { letzteOk = millis(); jemalsDaten = true; }
    zeigeHaupt(); modus = M_HAUPT;
  }
}

void ladeSzene(int n) {
  szene = n % SZENEN_ANZAHL;
  const Szene& z = SZENEN[szene];
  d.pv = z.pv; d.load = z.load; d.grid = z.grid; d.akku = z.akku; d.soc = z.soc;
  d.notstrom = z.notstrom; d.modus = z.modus;
  datenOk = true; jemalsDaten = true; letzteOk = millis();
}

void starteDemo() {
  beendeNachtuhr();
  demo = true;
  design = 1;                 // Demo beginnt mit dem Haus, danach Kacheln, dann wieder Haus ...
  helligkeit(HELL_TAG);
  ladeSzene(0);
  zeigeHaupt();
  modus = M_DEMO;
}

// Demo verlassen: ist das WLAN schon eingerichtet -> Live-Anzeige, sonst WLAN-Auswahl
void beendeDemo() {
  beendeNachtuhr();
  demo = false;
  design = designEinst;
  datenOk = false; jemalsDaten = false;
  d = Daten();
  if (WiFi.status() == WL_CONNECTED && inverterIp.length()) { zeigeHaupt(); modus = M_HAUPT; letzteAbfrage = 0; }
  else if (WiFi.status() == WL_CONNECTED) nachWlanVerbunden();
  else starteWlanAuswahl();
}

void serielleBefehle() {
  if (!Serial.available()) return;
  String cmd = Serial.readStringUntil('\n');
  cmd.trim();
  cmd.toLowerCase();
  if (cmd.length() && cmd != "nacht") { nachtErzwungen = false; if (!demo) beendeNachtuhr(); }
  if (cmd == "nacht") {
    Serial.println("Nachtuhr (Antippen beendet sie)");
    if (demo) beendeDemo();
    if (modus == M_HAUPT) { nachtErzwungen = true; starteNachtuhr(); }
    else Serial.println("Zuerst WLAN und Wechselrichter einrichten");
    return;
  }
  if (cmd == "demo")       { Serial.println("Demo startet"); starteDemo(); }
  else if (cmd == "intro") { Serial.println("Intro"); if (!demo && modus == M_HAUPT) { spieleIntro(design == 1 ? 2 : 1); zeigeHaupt(); } }
  else if (cmd == "live")  { Serial.println("Live-Anzeige"); wachBis = millis() + 30000; if (demo) beendeDemo(); else { zeigeHaupt(); modus = M_HAUPT; letzteAbfrage = 0; } }
  else if (cmd == "wlan")  { Serial.println("WLAN-Auswahl"); demo = false; design = designEinst; starteWlanAuswahl(); }
  else if (cmd == "haus" || cmd == "kacheln") {
    setzeDesign(cmd == "haus" ? 1 : 0);
    Serial.println(cmd == "haus" ? "Design: Haus" : "Design: Kacheln");
    if (demo) beendeDemo();
    else if (modus == M_HAUPT) zeigeHaupt();
  }
  else if (cmd == "reset") { Serial.println("Einstellungen geloescht, Neustart"); prefs.clear(); delay(300); ESP.restart(); }
  else if (cmd.length())   Serial.println("Unbekannter Befehl. Moeglich: demo, live, wlan, haus, kacheln, intro, nacht, reset");
}

void loopDemo() {
  static uint32_t letzteSzene = 0, letzteAnim = 0;
  int x, y;
  if (tipp(x, y)) {                                  // Antippen -> WLAN einrichten
    warteLoslassen();
    beendeDemo();
    return;
  }
  if (!letzteSzene) letzteSzene = millis();
  static uint8_t nachtSzene = 0;
  if (nachtuhr) {                                   // Demo-Teil Nachtuhr: Akku -> Haus, dann Netz -> Haus
    if (millis() - letzteSzene > 8000) {
      letzteSzene = millis();
      if (++nachtSzene >= 2) { nachtSzene = 0; beendeNachtuhr(); design = 1; ladeSzene(0); zeigeHaupt(); }
      else { ladeNachtDemo(1); nuUnten(false); }
    }
    letzteOk = millis();
    if (nachtuhr) loopNachtuhr();
    return;
  }
  if (millis() - letzteSzene > 5000) {              // alle 5 Sekunden naechster Zustand
    letzteSzene = millis();
    ladeSzene(szene + 1);
    if (szene == 0) {                               // nach jedem Durchlauf: Haus -> Kacheln -> Nachtuhr
      if (design == 1) { design = 0; zeigeHaupt(); }
      else { nachtSzene = 0; ladeNachtDemo(0); starteNachtuhr(); return; }
    }
    else zeichneDaten();
  }
  letzteOk = millis();
  if (millis() - letzteAnim >= 250) {
    letzteAnim = millis();
    animiere();
  }
  if (design == 1) hausStrahlen();
}

// ---------------------------------------------------------------- Start-Intro
bool jpgAusgabe(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bild) {
  if (y >= tft.height()) return false;
  tft.pushImage(x, y, w, h, bild);
  return true;
}

// variante: 0 = endet in der WLAN-Einrichtung, 1 = Kacheln, 2 = Haus
void spieleIntro(uint8_t variante) {
  const IntroBild* ende = variante == 0 ? INTRO_W : variante == 2 ? INTRO_H : INTRO_K;
  bool alt = tft.getSwapBytes();
  tft.setSwapBytes(false);
  TJpgDec.setJpgScale(1);
  TJpgDec.setSwapBytes(true);
  TJpgDec.setCallback(jpgAusgabe);
  uint32_t start = millis();
  for (int i = 0; i < INTRO_BILDER; i++) {
    if (ts.touched()) {                              // Antippen: gleich zum letzten Bild
      i = INTRO_BILDER - 1;
      while (ts.touched()) delay(10);
    }
    const IntroBild& b = i < INTRO_GEMEINSAM ? INTRO_GEM[i] : ende[i - INTRO_GEMEINSAM];
    tft.startWrite();
    TJpgDec.drawJpg(0, 0, b.d, b.n);
    tft.endWrite();
    while (millis() - start < (uint32_t)(i + 1) * INTRO_MS) delay(1);
  }
  tft.setSwapBytes(alt);
}

void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("solar13 startet");
  Serial.println("Befehle im Seriellen Monitor: demo, live, wlan, haus, kacheln, intro, nacht, reset");
  pinMode(LCD_BL, OUTPUT);
  digitalWrite(LCD_BL, HIGH);          // Hintergrundbeleuchtung sicher einschalten
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(C_BG);
  digitalWrite(LCD_BL, HIGH);
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(LCD_BL, 5000, 8);
#else
  ledcSetup(0, 5000, 8);
  ledcAttachPin(LCD_BL, 0);
#endif
  helligkeit(HELL_TAG);
  Serial.println("Display initialisiert");
  touchSPI.begin(T_CLK, T_MISO, T_MOSI, T_CS);
  ts.begin(touchSPI);
  ts.setRotation(1);
  Serial.println("Touch initialisiert");

  if (!sprHead.createSprite(320, 20) || !sprHero.createSprite(312, 94) || !sprTile.createSprite(102, 116) ||
      !sprHausOben.createSprite(320, 28) || !sprHausWerte.createSprite(HAUS_WERTE_W, HAUS_WERTE_H))
    Serial.println("Zu wenig Speicher fuer Sprites!");

  prefs.begin("solar", false);
  wifiSsid   = prefs.getString("ssid", "");
  wifiPass   = prefs.getString("pass", "");
  inverterIp = prefs.getString("ip", "");
  eHeute     = prefs.getFloat("eheute", 0);
  eGestern   = prefs.getFloat("egestern", 0);
  eTag       = prefs.getInt("etag", -1);
  designEinst = prefs.getUChar("design", 0);
  design      = designEinst;

  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);                         // kein WLAN-Stromsparmodus: stabilere Verbindung
  if (!wifiSsid.length()) {                         // erster Start: Intro -> WLAN-Einrichtung
    WiFi.disconnect();
    delay(100);
    WiFi.scanNetworks(true);                        // sucht die Netze schon waehrend des Intros
    spieleIntro(0);
    uint32_t t = millis();
    while (WiFi.scanComplete() == WIFI_SCAN_RUNNING && millis() - t < 8000) delay(50);
    int n = WiFi.scanComplete();
    if (n >= 0) { netzeUebernehmen(n); zeigeWlanListe(); modus = M_WLAN_LISTE; }
    else starteWlanAuswahl();
  } else {                                          // eingerichtet: Intro -> Live-Anzeige
    WiFi.begin(wifiSsid.c_str(), wifiPass.c_str()); // verbindet schon waehrend des Intros
    spieleIntro(design == 1 ? 2 : 1);
    uint32_t t = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t < 3000) delay(100);
    if (WiFi.status() == WL_CONNECTED || verbinde(wifiSsid, wifiPass, 20000)) nachWlanVerbunden();
    else starteWlanAuswahl();
  }
}

void loopHaupt() {
  static uint32_t druckStart = 0, letzteAnim = 0, letzteMinute = 0, letzteNachtPruefung = 0;
  static bool sollNacht = false;
  int x, y;
  // ---- Nachtuhr ein/aus
  if (millis() - letzteNachtPruefung > 1000) {
    letzteNachtPruefung = millis();
    sollNacht = nachtErzwungen || (istNachtZeit() && millis() > wachBis);
  }
  if (sollNacht && !nachtuhr) starteNachtuhr();
  if (!sollNacht && nachtuhr) { beendeNachtuhr(); pruefeNacht(); zeigeHaupt(); }
  if (nachtuhr) {
    if (tipp(x, y)) {                               // Antippen: 30 s normale Anzeige
      warteLoslassen();
      nachtErzwungen = false; sollNacht = false;
      wachBis = millis() + 30000; hellBis = wachBis;
      beendeNachtuhr(); pruefeNacht(); zeigeHaupt();
      return;
    }
    if (!letzteAbfrage || millis() - letzteAbfrage >= ABFRAGE_MS) {
      letzteAbfrage = millis();
      datenOk = frage();
      if (datenOk) { letzteOk = millis(); jemalsDaten = true; }
      nuUnten(false);
    }
    loopNachtuhr();
    return;
  }
  if (roh(x, y)) {
    hellBis = millis() + 30000;                   // Beruehrung: 30 s volle Helligkeit
    pruefeNacht();
    if (!druckStart) druckStart = millis();
    else if (millis() - druckStart > 2000) {      // lange druecken -> Einstellungen
      druckStart = 0;
      zeigeMenu(); modus = M_MENU; warteLoslassen();
      return;
    }
  } else druckStart = 0;

  if (!letzteAbfrage || millis() - letzteAbfrage >= ABFRAGE_MS) {
    letzteAbfrage = millis();
    datenOk = frage();
    if (datenOk) { letzteOk = millis(); jemalsDaten = true; }
    zeichneDaten();
  }
  if (millis() - letzteAnim >= 250) {              // Animation: Pfeile, Blinken
    letzteAnim = millis();
    animiere();
  }
  if (design == 1) hausStrahlen();                 // Sonnenstrahlen aufs Dach
  if (millis() - letzteMinute > 30000) { letzteMinute = millis(); if (design == 0) zeichneHero(); pruefeNacht(); }
}

void loopWlanListe() {
  int x, y;
  if (!tipp(x, y)) return;
  if (x > 220 && y < 38) { starteWlanAuswahl(); return; }
  for (size_t i = 0; i < netze.size(); i++) {
    int ry = 40 + i * 40;
    if (y >= ry && y < ry + 36) {
      zielSsid = netze[i].ssid;
      if (!netze[i].zu) {
        if (verbinde(zielSsid, "", 15000)) {
          wifiSsid = zielSsid; wifiPass = "";
          prefs.putString("ssid", wifiSsid); prefs.putString("pass", "");
          nachWlanVerbunden();
        } else { meldung("Verbindung fehlgeschlagen", ""); delay(1800); starteWlanAuswahl(); }
        return;
      }
      eingabe = (zielSsid == wifiSsid) ? wifiPass : "";
      gross = false; zahlen = false;
      zeigeTastatur();
      modus = M_TASTATUR;
      return;
    }
  }
}

void loopTastatur() {
  int x, y;
  if (!tipp(x, y)) return;
  if (y < 22 && x < 100) { zeigeWlanListe(); modus = M_WLAN_LISTE; return; }
  for (auto& k : tasten) {
    if (x < k.x || x >= k.x + k.w || y < k.y || y >= k.y + k.h) continue;
    switch (k.code) {
      case 0:       if (eingabe.length() < 63) eingabe += k.text; zeigeEingabefeld(true); break;
      case K_SPACE: eingabe += " "; zeigeEingabefeld(true); break;
      case K_DEL:   if (eingabe.length()) eingabe.remove(eingabe.length() - 1); zeigeEingabefeld(true); break;
      case K_SHIFT: if (!zahlen) { gross = !gross; zeigeTastatur(); } break;
      case K_NUM:   zahlen = !zahlen; zeigeTastatur(); break;
      case K_OK:
        if (verbinde(zielSsid, eingabe, 15000)) {
          wifiSsid = zielSsid; wifiPass = eingabe;
          prefs.putString("ssid", wifiSsid); prefs.putString("pass", wifiPass);
          meldung("Verbunden", wifiSsid); delay(1000);
          nachWlanVerbunden();
        } else {
          meldung("Verbindung fehlgeschlagen", "Passwort prüfen"); delay(2000);
          zeigeTastatur();
        }
        break;
    }
    return;
  }
}

void loopIp() {
  int x, y;
  if (!tipp(x, y)) return;
  for (auto& k : ipTasten) {
    if (x < k.x || x >= k.x + k.w || y < k.y || y >= k.y + k.h) continue;
    if (k.code == 0) { if (eingabe.length() < 15) eingabe += k.text; zeigeEingabefeld(false); }
    else if (k.code == K_DEL) { if (eingabe.length()) eingabe.remove(eingabe.length() - 1); zeigeEingabefeld(false); }
    else if (k.code == K_BACK) {
      if (inverterIp.length()) { zeigeHaupt(); modus = M_HAUPT; }
    } else if (k.code == K_OK) {
      IPAddress ip;
      if (ip.fromString(eingabe)) {
        inverterIp = eingabe;
        prefs.putString("ip", inverterIp);
        datenOk = false; jemalsDaten = false; letzteAbfrage = 0;
        zeigeHaupt(); modus = M_HAUPT;
      } else { meldung("Ungültige IP-Adresse", "Beispiel: 192.168.1.50"); delay(1800); zeigeIpEingabe(); }
    }
    return;
  }
}

void loopMenu() {
  int x, y;
  if (!tipp(x, y)) return;
  if (y >= 36 && y < 70) starteWlanAuswahl();
  else if (y >= 72 && y < 106) { eingabe = inverterIp; zeigeIpEingabe(); modus = M_IP; }
  else if (y >= 108 && y < 142) { setzeDesign(designEinst ? 0 : 1); zeigeMenu(); }
  else if (y >= 144 && y < 178) { warteLoslassen(); starteDemo(); }
  else if (y >= 180 && y < 214) { zeigeHaupt(); modus = M_HAUPT; letzteAbfrage = 0; }
}

void loop() {
  serielleBefehle();
  switch (modus) {
    case M_HAUPT:      loopHaupt(); break;
    case M_WLAN_LISTE: loopWlanListe(); break;
    case M_TASTATUR:   loopTastatur(); break;
    case M_IP:         loopIp(); break;
    case M_MENU:       loopMenu(); break;
    case M_DEMO:       loopDemo(); break;
  }
  delay(5);
}
