// ---------------------------------------------------------------- WLAN
bool verbinde(const String& ssid, const String& pass, uint32_t timeoutMs) {
  meldung("Verbinde mit WLAN …", ssid);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);                         // kein WLAN-Stromsparmodus: stabilere Verbindung
  WiFi.disconnect(true);
  delay(100);
  WiFi.begin(ssid.c_str(), pass.c_str());
  uint32_t t = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t < timeoutMs) delay(200);
  return WiFi.status() == WL_CONNECTED;
}

struct Netz { String ssid; int rssi; bool zu; };
std::vector<Netz> netze;
void netzeUebernehmen(int n);
void spieleIntro(uint8_t variante);

void scanne() {
  meldung("Suche WLAN-Netze …", "");
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);                         // kein WLAN-Stromsparmodus: stabilere Verbindung
  WiFi.disconnect();
  delay(100);
  netzeUebernehmen(WiFi.scanNetworks());
}

void netzeUebernehmen(int n) {
  netze.clear();
  for (int i = 0; i < n; i++) {
    String s = WiFi.SSID(i);
    if (!s.length()) continue;
    bool doppelt = false;
    for (auto& k : netze) if (k.ssid == s) { doppelt = true; if (WiFi.RSSI(i) > k.rssi) k.rssi = WiFi.RSSI(i); }
    if (!doppelt) netze.push_back({s, WiFi.RSSI(i), WiFi.encryptionType(i) != WIFI_AUTH_OPEN});
  }
  std::sort(netze.begin(), netze.end(), [](const Netz& a, const Netz& b) { return a.rssi > b.rssi; });
  if (netze.size() > 5) netze.resize(5);
  WiFi.scanDelete();
}

