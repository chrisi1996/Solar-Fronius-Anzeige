const char* WOTAG[7] = {"Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"};
const char* MONAT[12] = {"Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"};

// Himmel mit Nordlicht, Sternen, Sternschnuppe, Uhrzeit und Datum
void nuHimmel(float t) {
  static int16_t aT[3][320], aL[3][320];
  static const float y0[3] = {58, 78, 44}, sp[3] = {0.9f, 0.7f, 1.3f};
  static const uint8_t col[3][3] = {{80, 220, 170}, {60, 170, 230}, {120, 240, 190}};
  for (int k = 0; k < 3; k++)
    for (int x = 0; x < 320; x++) {
      float yc = y0[k] + sinf(x * 0.018f + t * 0.35f * sp[k]) * 16 + sinf(x * 0.041f - t * 0.22f) * 8;
      float h = 46 + sinf(x * 0.03f + t * 0.5f) * 18;
      aT[k][x] = (int16_t)(yc - h); aL[k][x] = (int16_t)(h + 10);
    }
  if (nsK < 0 && random(1000) < 12) { nsK = 0; nsX = random(90, 320); nsY = random(4, 50); }

  char hh[3] = "--", mm[3] = "--";
  String datum = "";
  struct tm t2;
  if (demo) { strcpy(hh, "23"); strcpy(mm, "47"); datum = "Demo"; }
  else if (getLocalTime(&t2, 5)) {
    snprintf(hh, 3, "%02d", t2.tm_hour); snprintf(mm, 3, "%02d", t2.tm_min);
    datum = String(WOTAG[t2.tm_wday]) + ", " + String(t2.tm_mday) + ". " + MONAT[t2.tm_mon];
  }
  bool doppel = (millis() / 1000) % 2 == 0;
  TFT_eSprite& s = sprNStreifen;
  for (int sy = 0; sy < NU_HIMMEL_H; sy += NU_STREIFEN) {
    for (int yy = 0; yy < NU_STREIFEN; yy++) {
      int y = sy + yy;
      for (int x = 0; x < 320; x++) {
        float r = nuR[y], g = nuG[y], b = nuB[y];
        for (int k = 0; k < 3; k++) {
          int dd = y - aT[k][x];
          if (dd <= 0 || dd >= aL[k][x]) continue;
          float f = (float)dd / aL[k][x];
          float a = (f < 0.75f ? f / 0.75f : (1 - f) / 0.25f) * 0.1f;
          r += col[k][0] * a; g += col[k][1] * a; b += col[k][2] * a;
        }
        s.drawPixel(x, yy, tft.color565(min(255, (int)r), min(255, (int)g), min(255, (int)b)));
      }
    }
    for (auto& st : nSterne) {                       // funkelnde Sterne
      if (st.y < sy || st.y >= sy + NU_STREIFEN) continue;
      uint8_t a = (uint8_t)((0.3f + 0.7f * fabsf(sinf(t * st.sp + st.ph))) * 200);
      int yy = st.y - sy;
      s.drawPixel(st.x, yy, tft.alphaBlend(a, C_WHITE, s.readPixel(st.x, yy)));
      if (st.gross) for (int q = 0; q < 4; q++) {
        int dx = (q == 0) - (q == 1), dy = (q == 2) - (q == 3);
        if (yy + dy >= 0 && yy + dy < NU_STREIFEN) s.drawPixel(st.x + dx, yy + dy, tft.alphaBlend(a / 3, C_WHITE, s.readPixel(st.x + dx, yy + dy)));
      }
    }
    if (nsK >= 0) {                                   // Sternschnuppe mit Schweif
      float x = nsX - nsK * 140, y = nsY + nsK * 55;
      for (int i = 0; i < 55; i++) {
        int px = (int)(x + i), py = (int)(y - i * 0.4f) - sy;
        if (px < 0 || px >= 320 || py < 0 || py >= NU_STREIFEN) continue;
        s.drawPixel(px, py, tft.alphaBlend((uint8_t)(240 * (1 - i / 55.0f)), C_WHITE, s.readPixel(px, py)));
      }
    }
    if (sy < 105) {                                   // grosse Uhrzeit (Grundlinie y = 84)
      s.loadFont(FONT_UHR);
      s.setTextDatum(L_BASELINE);
      int wh = s.textWidth(hh), wc = s.textWidth(":"), wm = s.textWidth(mm);
      int x0 = 160 - (wh + wc + wm) / 2;
      s.setTextColor(C_W2);                           // ohne Hintergrund: Kanten werden mit dem Himmel geglaettet
      s.drawString(hh, x0, 84 - sy);
      s.setTextColor(doppel ? C_W2 : tft.alphaBlend(60, C_W2, nuBg(60)));
      s.drawString(":", x0 + wh, 84 - sy);
      s.setTextColor(C_W2);
      s.drawString(mm, x0 + wh + wc, 84 - sy);
      s.unloadFont();
    }
    if (sy + NU_STREIFEN > 92 && sy < 112 && datum.length()) {
      s.loadFont(FONT_S);
      s.setTextDatum(MC_DATUM);
      s.setTextColor(demo ? C_YELLOW : C_BLUE);
      s.drawString(datum, 160, 104 - sy);
      s.unloadFont();
    }
    s.pushSprite(0, sy);
  }
  if (nsK >= 0) { nsK += 0.12f; if (nsK > 1) nsK = -1; }
}

// leuchtendes Kabel mit Lichtwellen: gruen vom Akku, rot vom Netz
void nuFluss(float t) {
  TFT_eSprite& s = sprNFluss;
  for (int y = 0; y < NU_FH; y++) s.drawFastHLine(0, y, NU_FW, nuBg(NU_FY + y));
  if (nuArt != 0) {
    uint16_t c = nuArt == 1 ? C_GREEN : C_RED, bg = nuBg(NU_FY + 25);
    const float sx = 92 - NU_FX, syy = 182 - NU_FY, ex = 222 - NU_FX, ey = 190 - NU_FY;
    const float mx = (sx + ex) / 2, my = min(syy, ey) - 30;
    auto P = [&](float k, float& x, float& y) {
      float u = 1 - k;
      x = u * u * sx + 2 * u * k * mx + k * k * ex;
      y = u * u * syy + 2 * u * k * my + k * k * ey;
    };
    float px, py, qx, qy;
    P(0, px, py);
    for (int i = 1; i <= 30; i++) {
      P(i / 30.0f, qx, qy);
      s.drawWideLine(px, py, qx, qy, 3, tft.alphaBlend(55, c, bg), bg);
      px = qx; py = qy;
    }
    for (int w = 0; w < 3; w++) {
      float ph = fmodf(t * 0.55f + w / 3.0f, 1.0f);
      P(ph, px, py);
      s.fillSmoothCircle((int)px, (int)py, 7, tft.alphaBlend(70, c, bg), bg);   // Leuchten um den Kopf
      for (int j = 13; j >= 0; j--) {
        float k = ph - j * 0.012f;
        if (k < 0 || k > 1) continue;
        P(k, px, py);
        s.fillCircle((int)px, (int)py, j == 0 ? 4 : 3, tft.alphaBlend((uint8_t)(240 * (1 - j / 14.0f)), c, bg));
      }
    }
  }
  s.pushSprite(NU_FX, NU_FY);
}

// oberster Akku-Balken pulsiert, solange der Akku das Haus versorgt
void nuSegment(float t) {
  if (nuArt != 1 || nuLit < 1) return;
  uint16_t bg = nuBg(182);
  uint8_t a = (uint8_t)((0.45f + 0.55f * fabsf(sinf(t * 2))) * 255);
  tft.fillSmoothRoundRect(32, nuSegY[nuLit - 1], 46, 9, 2, tft.alphaBlend(a, C_BLUE, tft.alphaBlend(30, C_BLUE, bg)), bg);
}

void starteNachtuhr() {
  if (nachtuhr) return;
  nachtuhr = true;
  designSprites(false);
  if (!sprNStreifen.createSprite(320, NU_STREIFEN) || !sprNFluss.createSprite(NU_FW, NU_FH))
    Serial.println("Zu wenig Speicher fuer die Nachtuhr!");
  for (int y = 0; y < 240; y++) {                       // dunkler Nachthimmel
    float f = y / 239.0f;
    nuR[y] = (uint8_t)((1 + 5 * f) * 0.75f); nuG[y] = (uint8_t)((3 + 15 * f) * 0.75f); nuB[y] = (uint8_t)((10 + 28 * f) * 0.75f);
  }
  for (auto& st : nSterne) {
    st.x = random(0, 320); st.y = random(0, NU_HIMMEL_H);
    st.ph = random(0, 628) / 100.0f; st.sp = 0.4f + random(0, 120) / 100.0f; st.gross = random(0, 10) < 2;
  }
  helligkeit(demo ? HELL_TAG : HELL_NACHT);
  nuUnten(true);
  nuHimmel(millis() / 1000.0f);
}

void beendeNachtuhr() {
  if (!nachtuhr) return;
  nachtuhr = false;
  sprNStreifen.deleteSprite();
  sprNFluss.deleteSprite();
  designSprites(true);
}

void loopNachtuhr() {
  static uint32_t tH = 0, tF = 0;
  uint32_t jetzt = millis();
  float t = jetzt / 1000.0f;
  if (jetzt - tH >= 110) { tH = jetzt; nuHimmel(t); }
  if (jetzt - tF >= 40) { tF = jetzt; nuFluss(t); nuSegment(t); }
}

