// ---------------------------------------------------------------- Fronius abfragen
void tagesertrag(float pvW) {
  struct tm t;
  if (!getLocalTime(&t, 10)) return;
  if (eTag != t.tm_yday) {                    // neuer Tag
    bool direktGestern = eTag != -1 && (t.tm_yday - eTag == 1 || (t.tm_yday == 0 && eTag >= 364));
    eGestern = direktGestern ? eHeute : 0;
    eHeute = 0;
    eTag = t.tm_yday;
    letztesSpeichern = 0;
  }
  uint32_t jetzt = millis();
  if (letzteIntegration) {
    float h = (jetzt - letzteIntegration) / 3600000.0f;
    if (h < 0.02f) eHeute += pvW * h / 1000.0f;   // nur kurze Luecken aufsummieren
  }
  letzteIntegration = jetzt;
  if (!letztesSpeichern || jetzt - letztesSpeichern > 600000UL) {   // alle 10 Minuten sichern
    prefs.putFloat("eheute", eHeute);
    prefs.putFloat("egestern", eGestern);
    prefs.putInt("etag", eTag);
    letztesSpeichern = jetzt;
  }
}

bool frage() {
  if (WiFi.status() != WL_CONNECTED || !inverterIp.length()) return false;
  HTTPClient http;
  http.setReuse(false);                      // jede Abfrage mit frischer Verbindung
  http.setConnectTimeout(3000);
  http.setTimeout(5000);                     // GEN24 antwortet manchmal langsam
  http.begin("http://" + inverterIp + "/solar_api/v1/GetPowerFlowRealtimeData.fcgi");
  int code = http.GET();
  if (code != 200) {
    Serial.printf("Fronius: HTTP %d (%s), WLAN %d dBm, freier Speicher %u\n", code, http.errorToString(code).c_str(), WiFi.RSSI(), ESP.getFreeHeap());
    http.end();
    return false;
  }
  String body = http.getString();
  http.end();
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, body);
  if (err) { Serial.printf("Fronius: JSON-Fehler %s\n", err.c_str()); return false; }
  JsonObject site = doc["Body"]["Data"]["Site"];
  if (site.isNull()) { Serial.println("Fronius: keine Site-Daten"); return false; }
  d.pv   = site["P_PV"]   | 0.0f;            // null in der Nacht -> 0
  d.load = fabsf(site["P_Load"] | 0.0f);     // Verbrauch ist negativ angegeben
  d.grid = site["P_Grid"] | 0.0f;            // + Bezug, - Einspeisung
  d.akku = site["P_Akku"] | 0.0f;            // + Entladen, - Laden
  if (d.pv < 0) d.pv = 0;
  d.notstrom = site["BackupMode"] | false;     // Stromausfall, Notstrombetrieb
  d.modus = AK_NORMAL;
  for (JsonPair kv : doc["Body"]["Data"]["Inverters"].as<JsonObject>()) {
    if (!kv.value()["SOC"].isNull()) d.soc = kv.value()["SOC"].as<float>();
    String bm = kv.value()["Battery_Mode"] | "";
    bm.toLowerCase();
    if (bm.indexOf("calib") >= 0) d.modus = AK_KALIB;
    else if (bm.indexOf("service") >= 0 || bm.indexOf("suspend") >= 0 || bm.indexOf("non operable") >= 0 ||
             bm.indexOf("stopped") >= 0 || bm.indexOf("disabled") >= 0) d.modus = AK_AUS;
  }
  tagesertrag(d.pv);
  return true;
}

