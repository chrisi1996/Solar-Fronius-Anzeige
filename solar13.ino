// ---------------------------------------------------------------- Bildschirmtastatur
struct Taste { int16_t x, y, w, h; String text; int code; };   // code: 0 = Zeichen
enum { K_SHIFT = 1, K_NUM, K_SPACE, K_DEL, K_OK, K_BACK };
std::vector<Taste> tasten;
String eingabe, zielSsid;
bool gross = false, zahlen = false;

void baueTastatur() {
  tasten.clear();
  const char* r1 = zahlen ? "1234567890" : "qwertzuiop";
  const char* r2 = zahlen ? "-_.@#&*+!?" : "asdfghjkl";
  const char* r3 = zahlen ? "/:;()$%=" : "yxcvbnm";
  const char* reihen[3] = {r1, r2, r3};
  for (int r = 0; r < 3; r++) {
    int n = strlen(reihen[r]);
    int x0 = (320 - (n * 32 - 4)) / 2;
    for (int i = 0; i < n; i++) {
      char c = reihen[r][i];
      if (gross && !zahlen) c = toupper(c);
      tasten.push_back({(int16_t)(x0 + i * 32), (int16_t)(62 + r * 44), 28, 40, String(c), 0});
    }
  }
  tasten.push_back({2, 194, 44, 40, zahlen ? "" : (gross ? "abc" : "ABC"), K_SHIFT});
  tasten.push_back({50, 194, 44, 40, zahlen ? "abc" : "123", K_NUM});
  tasten.push_back({98, 194, 116, 40, "Leer", K_SPACE});
  tasten.push_back({218, 194, 44, 40, "<", K_DEL});
  tasten.push_back({266, 194, 52, 40, "OK", K_OK});
}

