}

void zeigeTastatur() {
  baueTastatur();
  tft.fillScreen(C_BG);
  tft.loadFont(FONT_S);
  tft.setTextColor(C_BLUE, C_BG);
  tft.setTextDatum(TL_DATUM);
  tft.drawString("< Zurück", 8, 3);
  String t = "Passwort für " + zielSsid;
  while (tft.textWidth(t) > 210 && t.length() > 3) t.remove(t.length() - 1);
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(C_W2, C_BG);
  tft.drawString(t, 312, 3);
  tft.unloadFont();
  zeigeEingabefeld(true);
  tft.loadFont(FONT_M);
  for (auto& k : tasten) {
    if (k.code == K_SHIFT && zahlen) continue;
    uint16_t f = k.code == K_OK ? C_BLUE3 : (k.code ? C_CARD : C_KEY);
    if (k.code >= K_SHIFT && k.code != K_OK) { tft.unloadFont(); tft.loadFont(FONT_S); }
    knopf(k.x, k.y, k.w, k.h, k.text, f);
    if (k.code >= K_SHIFT && k.code != K_OK) { tft.unloadFont(); tft.loadFont(FONT_M); }
  }
  tft.unloadFont();
}

