// ---------------------------------------------------------------- Hilfen
String kw(float w) {
  char b[12];
  snprintf(b, sizeof b, "%.1f", fabsf(w) / 1000.0f);
  for (char* p = b; *p; p++) if (*p == '.') *p = ',';
  return String(b);
}

void drawIcon(TFT_eSPI& g, const Icon& ic, int x, int y, uint16_t fg, uint16_t bg) {
  for (int j = 0; j < ic.h; j++)
    for (int i = 0; i < ic.w; i++) {
      uint8_t a = pgm_read_byte(ic.a + j * ic.w + i);
      if (a < 8) continue;
      g.drawPixel(x + i, y + j, a > 247 ? fg : g.alphaBlend(a, fg, bg));
    }
}

const Icon& akkuIcon(float soc) {
  if (soc >= 88) return IC_BAT4;
  if (soc >= 63) return IC_BAT3;
  if (soc >= 38) return IC_BAT2;
  if (soc > AKKU_RESERVE + 3) return IC_BAT1;
  return IC_BAT0;
}

uint16_t dimmen(uint16_t c, uint16_t bg) { return tft.alphaBlend(100, c, bg); }

// ---------------------------------------------------------------- Touch
bool roh(int& x, int& y) {
  if (!ts.touched()) return false;
  TS_Point p = ts.getPoint();
#if TOUCH_DEBUG
  Serial.printf("Touch roh: x=%d y=%d z=%d\n", p.x, p.y, p.z);
#endif
  if (p.z < 200) return false;
  x = constrain(map(p.x, TS_MINX, TS_MAXX, 0, 319), 0, 319);
  y = constrain(map(p.y, TS_MINY, TS_MAXY, 0, 239), 0, 239);
  return true;
}

bool warGedrueckt = false;
// liefert true genau einmal pro Antippen
bool tipp(int& x, int& y) {
  int tx, ty;
  bool jetzt = roh(tx, ty);
  bool neu = jetzt && !warGedrueckt;
  warGedrueckt = jetzt;
  if (neu) { x = tx; y = ty; delay(30); }
  return neu;
}

void warteLoslassen() {
  uint32_t t = millis();
  while (millis() - t < 3000) {
    int x, y;
    if (!roh(x, y)) { delay(60); if (!ts.touched()) break; }
    delay(20);
  }
  warGedrueckt = false;
}

