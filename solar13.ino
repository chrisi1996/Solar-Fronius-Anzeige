// kleines Akku-Symbol passend zum Ladestand
const Icon& akkuKlein(float soc) {
  if (soc >= 88) return IC_BATS4;
  if (soc >= 63) return IC_BATS3;
  if (soc >= 38) return IC_BATS2;
  if (soc > AKKU_RESERVE + 3) return IC_BATS1;
  return IC_BATS0;
}

Teil symbol(const Icon* ic, uint16_t farbe) {
  Teil t; t.ic = ic; t.farbe = farbe; t.text = ""; t.pfeil = 0; return t;
}
Teil pfeilTeil(const Icon* ic, uint16_t farbe, int8_t richtung) {
  Teil t; t.ic = ic; t.farbe = farbe; t.text = ""; t.pfeil = richtung; return t;
}
Teil textTeil(const String& s, uint16_t farbe) {
  Teil t; t.ic = nullptr; t.farbe = farbe; t.text = s; t.pfeil = 0; return t;
}

void piktogramm(TFT_eSprite& s, const std::vector<Teil>& teile, int cy) {
  s.loadFont(FONT_S);
  auto breite = [&](const Teil& t) -> int {
    if (!t.ic) return s.textWidth(t.text);
    return t.ic2 ? max((int)t.ic->w, (int)t.ic2->w) : t.ic->w;
  };
  int gesamt = 0;
  for (auto& t : teile) gesamt += breite(t) + 4;
  gesamt -= 4;
  int x = (102 - gesamt) / 2;
  int stups = (tick % 4) < 2 ? -2 : 2;
  for (auto& t : teile) {
    int w = breite(t);
    if (t.ic && t.ic2) {                         // zwei kleine Symbole uebereinander
      int h = t.ic->h + 2 + t.ic2->h;
      int y0 = cy - h / 2;
      drawIcon(s, *t.ic, x + (w - t.ic->w) / 2, y0, t.farbe, C_CARD);
      drawIcon(s, *t.ic2, x + (w - t.ic2->w) / 2, y0 + t.ic->h + 2, t.farbe2, C_CARD);
    } else if (t.ic) {
      int dx = t.pfeil ? stups * t.pfeil : 0;
      int y0 = cy - t.ic->h / 2;
      drawIcon(s, *t.ic, x + dx, y0, t.farbe, C_CARD);
      if (t.durch) s.drawWideLine(x + 1, y0 + t.ic->h - 2, x + t.ic->w - 1, y0 + 1, 2.4, C_RED, C_CARD);
    } else {
      s.setTextColor(t.farbe, C_CARD);
      s.setTextDatum(ML_DATUM);
      s.drawString(t.text, x, cy);
    }
    x += w + 4;
  }
  s.unloadFont();
}

// wert = NAN -> statt Zahl wird "–" angezeigt; rahmen = 0 -> kein Rahmen
void kachel(int x, const String& titel, const String& rechts, uint16_t titelFarbe,
            float wert, uint16_t wertFarbe, const std::vector<Teil>& teile, uint16_t rahmen) {
  TFT_eSprite& s = sprTile;          // 102 x 116
  s.fillSprite(C_BG);
  if (rahmen) {
    s.fillSmoothRoundRect(0, 0, 102, 116, 10, rahmen, C_BG);
    s.fillSmoothRoundRect(2, 2, 98, 112, 8, C_CARD, rahmen);
  } else {
    s.fillSmoothRoundRect(0, 0, 102, 116, 10, C_CARD, C_BG);
  }
  s.loadFont(FONT_M);
  s.setTextColor(titelFarbe, C_CARD);
  s.setTextDatum(TL_DATUM);
  s.drawString(titel, 8, 9);
  if (rechts.length()) {                     // Ladestand rechts neben "Akku", ohne %-Zeichen
    s.setTextColor(titelFarbe == C_GREY ? C_GREY : C_BLUE, C_CARD);
    s.setTextDatum(TR_DATUM);
    s.drawString(rechts, 94, 10);
  }
  s.unloadFont();
  s.loadFont(FONT_L);
  s.setTextColor(wertFarbe, C_CARD);
  s.setTextDatum(L_BASELINE);
  if (wert != wert) {                         // NAN: keine Zahl
    s.drawString("–", 8, 70);
    s.unloadFont();
  } else {
    String z = kw(wert);
    s.drawString(z, 8, 70);
    int zw = s.textWidth(z);
    s.unloadFont();
    s.loadFont(FONT_S);
    s.setTextColor(C_BLUE, C_CARD);
    s.setTextDatum(L_BASELINE);
    s.drawString("kW", 8 + zw + 3, 70);
    s.unloadFont();
  }
  piktogramm(s, teile, 94);
  s.pushSprite(x, 120);
}

void zeichneKacheln() {
  const float T = SCHWELLE_W;
  bool blink = (tick % 4) < 2;
  bool wechsel = (tick / 8) % 2;            // alle 2 Sekunden umschalten

  // ---- Haus: woher kommt der Strom? Groesste Quelle gross, die anderen klein
  float vonNetz = max(d.grid, 0.0f), vonAkku = max(d.akku, 0.0f);
  float vonSonne = max(d.load - vonNetz - vonAkku, 0.0f);
  struct Q { float w; int art; } q[3] = {{vonSonne, 0}, {vonAkku, 1}, {vonNetz, 2}};
  std::sort(q, q + 3, [](const Q& a, const Q& b) { return a.w > b.w; });
  auto grossIcon = [&](int art) -> Teil {
    if (art == 0) return symbol(&IC_SUN22, C_YELLOW);
    if (art == 1) return symbol(&akkuIcon(d.soc), C_YELLOW);
    return symbol(&IC_PYLON, C_RED);
  };
  auto kleinIc = [&](int art) -> const Icon* {
    if (art == 0) return &IC_SUN14;
    if (art == 1) return &akkuKlein(d.soc);
    return &IC_PYLON_S;
  };
  auto kleinFarbe = [](int art) -> uint16_t { return art == 2 ? C_RED : C_YELLOW; };
  std::vector<Teil> haus;
  if (d.load < T) {
    haus = {symbol(&IC_HOME22, C_GREY), textTeil("–", C_GREY)};
  } else {
    float grenze = max(T, d.load * 0.1f);
    bool zweite = q[1].w > grenze, dritte = q[2].w > grenze;
    uint16_t pf = q[0].art == 2 ? C_RED : C_YELLOW;
    haus.push_back(grossIcon(q[0].art));
    if (zweite && dritte) {                  // drei Quellen: zwei kleine uebereinander
      Teil t = symbol(kleinIc(q[1].art), kleinFarbe(q[1].art));
      t.ic2 = kleinIc(q[2].art); t.farbe2 = kleinFarbe(q[2].art);
      haus.push_back(t);
    } else if (zweite) {
      haus.push_back(symbol(kleinIc(q[1].art), kleinFarbe(q[1].art)));
    }
    haus.push_back(pfeilTeil(&IC_ARR_R, pf, 1));
    haus.push_back(symbol(&IC_HOME22, C_W2));
  }
  kachel(4, "Haus", "", C_W2, d.load, C_WHITE, haus, 0);

  // ---- Akku
  String soc = String((int)roundf(d.soc));
  std::vector<Teil> akku;
  uint16_t tf = C_W2, wf = C_WHITE;
  if (d.modus == AK_AUS) {                             // gesperrt / Service
    akku = {symbol(&akkuIcon(d.soc), C_GREY), textTeil("aus", C_GREY)};
    tf = C_GREY; wf = C_GREY;
  } else if (d.akku < -T) {                            // laedt
    bool ausSonne = d.pv >= -d.akku * 0.8f;
    if (d.modus == AK_KALIB && wechsel)
      akku = {symbol(&akkuIcon(d.soc), C_BLUE), textTeil("Kalibr.", C_BLUE)};
    else
      akku = {ausSonne ? symbol(&IC_SUN22, C_YELLOW) : symbol(&IC_PYLON, C_RED),
              pfeilTeil(&IC_ARR_R, ausSonne ? C_YELLOW : C_RED, 1), symbol(&akkuIcon(d.soc), C_BLUE)};
  } else if (d.akku > T) {                             // entlaedt
    akku = {symbol(&akkuIcon(d.soc), C_YELLOW), pfeilTeil(&IC_ARR_R, C_YELLOW, 1), symbol(&IC_HOME22, C_W2)};
    wf = C_YELLOW;
  } else if (d.modus == AK_KALIB) {
    akku = {symbol(&akkuIcon(d.soc), C_BLUE), textTeil("Kalibr.", C_BLUE)};
  } else if (d.soc <= AKKU_RESERVE + 0.5f) {           // leer
    akku = {symbol(&IC_BAT0, blink ? C_RED : dimmen(C_RED, C_CARD)), textTeil("leer", C_RED)};
    tf = C_GREY; wf = C_GREY;
  } else if (d.soc >= 99) {                            // voll
    akku = {symbol(&IC_BAT4, C_GREEN), textTeil("voll", C_GREEN)};
  } else {                                             // Ruhe
    akku = {symbol(&akkuIcon(d.soc), C_GREY), textTeil("–", C_GREY)};
    wf = C_GREY;
  }
  kachel(109, "Akku", soc, tf, d.akku, wf, akku, 0);

  // ---- Netz
  std::vector<Teil> netz;
  if (d.notstrom) {                                    // Stromausfall
    Teil m = symbol(&IC_PYLON, C_GREY); m.durch = true;
    netz = {m, textTeil("Ausfall", C_RED)};
    kachel(214, "Netz", "", C_W2, NAN, C_GREY, netz, C_RED);
    return;
  }
  uint16_t nf = C_WHITE;
  if (d.grid > T) {                                    // Bezug
    netz = {symbol(&IC_PYLON, C_RED), pfeilTeil(&IC_ARR_R, C_RED, 1), symbol(&IC_HOME22, C_W2)};
    nf = C_RED;
  } else if (d.grid < -T) {                            // Einspeisung
    netz = {symbol(&IC_PYLON, C_GREEN), pfeilTeil(&IC_ARR_L, C_GREEN, -1), symbol(&IC_HOME22, C_W2)};
    nf = C_GREEN;
  } else {
    netz = {symbol(&IC_PYLON, C_GREY), textTeil("–", C_GREY)};
  }
  kachel(214, "Netz", "", C_W2, d.grid, nf, netz, 0);
}

// ---------------------------------------------------------------- Design "Haus"
// Vorgerendertes Bild des eigenen Hauses (Tag/Nacht, 256 Farben) mit den Live-Werten
// als "Pillen" links oben und animierten Sonnenstrahlen aufs Solardach.
const int HAUS_WERTE_Y = 30, HAUS_WERTE_W = 180, HAUS_WERTE_H = 108;
bool hausNacht = false;
struct StrahlPuls { float pos; int16_t px[20][2]; uint8_t n; };
StrahlPuls puls[3] = {{0, {}, 0}, {22, {}, 0}, {44, {}, 0}};
const int PULS_LEN = 18;

inline uint16_t hausPixel(int x, int y) {
  if (hausNacht) return HAUS_NACHT_PAL[HAUS_NACHT_IDX[y * 320 + x]];
  return HAUS_TAG_PAL[HAUS_TAG_IDX[y * 320 + x]];
}

void hausBild() {
  static uint16_t zeile[320];
  bool alt = tft.getSwapBytes();
  tft.setSwapBytes(true);
  for (int y = 0; y < 240; y++) {
    for (int x = 0; x < 320; x++) zeile[x] = hausPixel(x, y);
    tft.pushImage(0, y, 320, 1, zeile);
  }
  tft.setSwapBytes(alt);
  for (auto& p : puls) p.n = 0;
}

// Bildausschnitt als Hintergrund ins Sprite kopieren
void hausHintergrund(TFT_eSprite& s, int x0, int y0) {
  for (int y = 0; y < s.height(); y++)
    for (int x = 0; x < s.width(); x++) s.drawPixel(x, y, hausPixel(x0 + x, y0 + y));
}

PTeil pI(const Icon* ic, uint16_t f) { return PTeil{ic, "", f, false}; }
PTeil pT(const String& t, uint16_t f) { return PTeil{nullptr, t, f, false}; }
PTeil pP(uint16_t f) { return PTeil{nullptr, "", f, true}; }

int pillenBreite(TFT_eSprite& s, const std::vector<PTeil>& t) {
  int w = 18;
  for (size_t i = 0; i < t.size(); i++)
    w += (t[i].punkt ? 8 : t[i].ic ? t[i].ic->w : s.textWidth(t[i].txt)) + (i ? 5 : 0);
  return w;
}

// Pille ins Sprite zeichnen; (ox, oy) = Lage des Sprites am Bildschirm (fuer glatte Kanten)
int pille(TFT_eSprite& s, int x, int y, const std::vector<PTeil>& t, uint16_t rand, int ox, int oy) {
  const int h = 24;
  int w = pillenBreite(s, t);
  uint16_t bg = hausPixel(constrain(ox + x + 2, 0, 319), constrain(oy + y + h / 2, 0, 239));
  s.fillSmoothRoundRect(x, y, w, h, h / 2, rand, bg);
  s.fillSmoothRoundRect(x + 1, y + 1, w - 2, h - 2, h / 2 - 1, C_PILL, rand);
  int cx = x + 9;
  for (size_t i = 0; i < t.size(); i++) {
    if (i) cx += 5;
    if (t[i].punkt) { s.fillSmoothCircle(cx + 4, y + h / 2, 4, t[i].farbe, C_PILL); cx += 8; }
    else if (t[i].ic) { drawIcon(s, *t[i].ic, cx, y + (h - t[i].ic->h) / 2, t[i].farbe, C_PILL); cx += t[i].ic->w; }
    else {
      s.setTextColor(t[i].farbe, C_PILL);
      s.setTextDatum(ML_DATUM);
      s.drawString(t[i].txt, cx, y + h / 2 + 1);
      cx += s.textWidth(t[i].txt);
    }
  }
  return w;
}

uint16_t randFarbe(uint16_t c) { return tft.alphaBlend(120, c, C_PILL); }

// Kopfzeile: Status, Tagesertrag, Uhrzeit
void hausKopf() {
  TFT_eSprite& s = sprHausOben;      // 320 x 28 bei (0, 0)
  hausHintergrund(s, 0, 0);
  s.loadFont(FONT_S);
  String status; uint16_t punkt, tf = C_W2;
  bool frisch = jemalsDaten && millis() - letzteOk < VERLOREN_MS;   // einzelne Aussetzer ignorieren
  bool schnell = false;
  if (demo) { status = "Demo"; punkt = C_YELLOW; tf = C_YELLOW; }
  else if (WiFi.status() != WL_CONNECTED) { status = "Kein WLAN"; punkt = C_RED; }
  else if (!frisch) { status = jemalsDaten ? "Keine Verbindung" : "Warte …"; punkt = C_RED; }
  else if (d.notstrom) { status = "Notstrom"; punkt = C_RED; tf = C_RED; schnell = true; }
  else { status = "Live"; punkt = C_GREEN; }
  bool an = demo || !frisch || (schnell ? (tick % 4) < 2 : (tick % 8) < 5);
  int x = 6;
  x += pille(s, x, 2, {pP(an ? punkt : dimmen(punkt, C_PILL)), pT(status, tf)}, randFarbe(punkt), 0, 0) + 5;

  struct tm t;
  bool gestern = getLocalTime(&t, 5) && t.tm_hour < 12 && eHeute < 0.05f && eGestern > 0;
  float wertKwh = gestern ? eGestern : eHeute;
  if (demo) { gestern = SZENEN[szene].gestern; wertKwh = SZENEN[szene].kwh; }
  char b[12];
  snprintf(b, sizeof b, "%.1f", wertKwh);
  for (char* p = b; *p; p++) if (*p == '.') *p = ',';
  pille(s, x, 2, {pT(b, C_WHITE), pT(gestern ? "kWh gestern" : "kWh heute", C_BLUE)}, randFarbe(C_BLUE), 0, 0);

  String uhr = "";
  if (demo) uhr = SZENEN[szene].zeit;
  else if (getLocalTime(&t, 5)) { char u[6]; strftime(u, sizeof u, "%H:%M", &t); uhr = u; }
  if (uhr.length()) {
    std::vector<PTeil> z = {pT(uhr, C_W2)};
    pille(s, 314 - pillenBreite(s, z), 2, z, randFarbe(C_BLUE2), 0, 0);
  }
  s.unloadFont();
  s.pushSprite(0, 0);
}

// Live-Werte links oben: Sonne, Haus, Akku, Netz
void hausWerte() {
  TFT_eSprite& s = sprHausWerte;     // 180 x 108 bei (0, 30)
  hausHintergrund(s, 0, HAUS_WERTE_Y);
  s.loadFont(FONT_S);
  const int oy = HAUS_WERTE_Y;
  int y = 0;
  bool sonne = d.pv >= SCHWELLE_W;
  pille(s, 6, y, {pI(&IC_SUN14, sonne ? C_YELLOW : C_GREY), pT(kw(d.pv) + " kW", sonne ? C_WHITE : C_GREY)},
        randFarbe(sonne ? C_YELLOW : C_GREY), 0, oy);
  y += 27;
  pille(s, 6, y, {pI(&IC_HOME22, C_W2), pT(kw(d.load) + " kW", C_WHITE)}, randFarbe(C_W2), 0, oy);
  y += 27;
  bool leer = d.soc <= AKKU_RESERVE;
  uint16_t af = leer ? C_GREY : C_BLUE;
  std::vector<PTeil> a = {pI(&akkuKlein(d.soc), af), pT(String((int)roundf(d.soc)) + " %", af)};
  if (d.modus == AK_KALIB)          a.push_back(pT("Kalibrierung", C_YELLOW));
  else if (d.modus == AK_AUS)       a.push_back(pT("aus", C_GREY));
  else if (d.akku < -SCHWELLE_W)    a.push_back(pT("+" + kw(d.akku), C_GREEN));    // laedt
  else if (d.akku > SCHWELLE_W)     a.push_back(pT("-" + kw(d.akku), C_BLUE2));    // entlaedt
  else if (leer)                    a.push_back(pT("leer", C_RED));
  pille(s, 6, y, a, randFarbe(af), 0, oy);
  y += 27;
  std::vector<PTeil> n;
  uint16_t nf;
  if (d.notstrom)                   { nf = C_RED;   n = {pI(&IC_PYLON_S, nf), pT("Ausfall", nf)}; }
  else if (d.grid > SCHWELLE_W)     { nf = C_RED;   n = {pI(&IC_PYLON_S, nf), pT(kw(d.grid) + " kW", nf)}; }   // Bezug
  else if (d.grid < -SCHWELLE_W)    { nf = C_GREEN; n = {pI(&IC_PYLON_S, nf), pT(kw(d.grid) + " kW", nf)}; }   // Einspeisung
  else                              { nf = C_GREY;  n = {pI(&IC_PYLON_S, nf), pT("0,0 kW", nf)}; }
  pille(s, 6, y, n, randFarbe(nf), 0, oy);
  s.unloadFont();
  s.pushSprite(0, HAUS_WERTE_Y);
}

// Sonnenstrahlen: leuchtende Pulse wandern von der Sonne aufs Dach (mehr Strahlen bei mehr Leistung)
void hausStrahlen() {
  static uint32_t letzte = 0;
  if (millis() - letzte < 40) return;
  letzte = millis();
  int anzahl = (hausNacht || d.pv < SCHWELLE_W) ? 0 : (d.pv >= 0.5f * PEAK_W ? 3 : d.pv >= 0.15f * PEAK_W ? 2 : 1);
  static const uint8_t reihe[3] = {1, 0, 2};
  for (auto& p : puls) {                       // alte Pixel wiederherstellen
    for (int k = 0; k < p.n; k++) {
      int x = p.px[k][0], y = p.px[k][1];
      tft.drawPixel(x, y, hausPixel(x, y));
      if (y + 1 < 240) tft.drawPixel(x, y + 1, hausPixel(x, y + 1));
    }
    p.n = 0;
  }
  for (int r = 0; r < anzahl; r++) {
    int i = reihe[r];
    StrahlPuls& p = puls[i];
    int len = STRAHL_LEN[i];
    p.pos += 2.0f;
    if (p.pos >= len + PULS_LEN) p.pos = 0;
    int kopf = (int)p.pos;
    for (int k = 0; k < PULS_LEN && p.n < 20; k++) {
      int j = kopf - k;
      if (j < 0 || j >= len) continue;
      int x = STRAHLEN[i][j][0], y = STRAHLEN[i][j][1];
      uint8_t a = 255 - k * 230 / PULS_LEN;
      tft.drawPixel(x, y, tft.alphaBlend(a, C_STRAHL, hausPixel(x, y)));
      if (y + 1 < 240) tft.drawPixel(x, y + 1, tft.alphaBlend(a / 2, C_STRAHL, hausPixel(x, y + 1)));
      p.px[p.n][0] = x; p.px[p.n][1] = y; p.n++;
    }
  }
}

